{
  "name": "agent-hub",
  "version": "1.9.0",
  "description": "Visual manager for IA agents and dev projects",
  "main": "src/backend/main.js",
  "scripts": {
    "start": "electron .",
    "predev": "node scripts/kill-dev-ports.js",
    "dev": "concurrently -k --success first -n vite,electron -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:vite": "vite",
    "build:renderer": "vite build",
    "test:backend": "node --test tests/backend/*.test.js",
    "prepare:build": "npm run build:renderer && node scripts/generate-icon.js",
    "build": "npm run prepare:build && electron-builder --win portable",
    "build:dir": "npm run prepare:build && electron-builder --win dir",
    "postbuild": "node scripts/post-build.js",
    "release": "npm run prepare:build && electron-builder --win portable --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "sharp": "^0.33.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "author": "Adán Oliva",
  "license": "MIT"
}
