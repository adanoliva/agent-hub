{
  "name": "agent-hub",
  "version": "1.2.5",
  "description": "Visual manager for IA agents and dev projects",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "prebuild": "node scripts/generate-icon.js",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir",
    "postbuild": "node scripts/post-build.js",
    "release": "electron-builder --win portable --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.0"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "author": "",
  "license": "MIT"
}
